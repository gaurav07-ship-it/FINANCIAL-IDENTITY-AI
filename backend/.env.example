# --- App ---
ENV=dev
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+asyncpg://fia:fia_dev_only@localhost:5432/fia
DATABASE_URL_SYNC=postgresql://fia:fia_dev_only@localhost:5432/fia

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=dev-secret-change-me-in-production
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false          # set true in prod
COOKIE_DOMAIN=localhost

# --- CORS ---
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Aggregator providers ---
AGGREGATOR_PROVIDER=mock     # mock | setu | finbox
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_BASE_URL=https://prod.setu.co
FINBOX_API_KEY=

# --- Seed ---
SEED_DEMO_USER=true
SEED_DEMO_EMAIL=arjun@joshi.studio
SEED_DEMO_PASSWORD=Arjun@2026
